# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobdb
DB_USER=jobuser
DB_PASSWORD=jobpass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Notes:
# - Copy this file to .env for local development
# - In Docker, these are set automatically via docker-compose.yaml
# - In production, set these via your deployment platform (Kubernetes, AWS, etc.)
# - Never commit .env with real credentials to version control

